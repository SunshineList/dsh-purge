{
  "name": "dsh-purge",
  "version": "1.1.72-dsh021rc2.6",
  "description": "DeepSeek Harness 破甲：让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。Jailbreak for every model — swap prompts per model. 已适配 DSH 0.2.1-rc.2（{{cwd}} 变量、#40 锚点、#119 await、#127 closeSync、红队 toolFilter）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "LICENSE-COMMERCIAL.md"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "node test/identity.test.mjs && node test/patches.test.mjs",
    "test:redteam": "node test/redteam-env.test.mjs",
    "test:sandbox": "node test/sandbox-apply.mjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunshineList/dsh-purge.git"
  },
  "homepage": "https://github.com/SunshineList/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/SunshineList/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/SunshineList/dsh-purge/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/SunshineList/dsh-purge/archive/refs/heads/main.zip",
      "git": "https://github.com/SunshineList/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2",
  "contributors": [
    {
      "name": "小杨 (YuJunZhiXue)",
      "url": "https://github.com/YuJunZhiXue/dsh-purge"
    }
  ]
}
